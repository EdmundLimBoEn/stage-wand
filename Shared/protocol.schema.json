{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edmundlim.systems/stagewand/protocol.schema.json",
  "title": "Stage Wand wire frames",
  "description": "JSON text frames for the LAN WebSocket protocol. Shared/Protocol.swift is the source of truth. This schema documents the frozen t discriminator.",
  "$defs": {
    "button": { "type": "string", "enum": ["left", "right"] },
    "key": { "type": "string", "enum": ["left", "right", "esc"] },
    "chord": { "type": "string", "enum": ["spaceLeft", "spaceRight", "missionControl"] },
    "byeReason": { "type": "string", "enum": ["kicked", "displaced", "badauth"] },
    "finiteNumber": { "type": "number" },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "code"],
          "properties": {
            "t": { "const": "auth" },
            "code": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "dx", "dy"],
          "properties": {
            "t": { "const": "move" },
            "dx": { "$ref": "#/$defs/finiteNumber" },
            "dy": { "$ref": "#/$defs/finiteNumber" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "b"],
          "properties": {
            "t": { "const": "click" },
            "b": { "$ref": "#/$defs/button" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "dx", "dy"],
          "properties": {
            "t": { "const": "scroll" },
            "dx": { "$ref": "#/$defs/finiteNumber" },
            "dy": { "$ref": "#/$defs/finiteNumber" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "k"],
          "properties": {
            "t": { "const": "key" },
            "k": { "$ref": "#/$defs/key" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "k"],
          "properties": {
            "t": { "const": "chord" },
            "k": { "$ref": "#/$defs/chord" }
          }
        }
      ]
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t"],
          "properties": {
            "t": { "const": "status" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "reason"],
          "properties": {
            "t": { "const": "bye" },
            "reason": { "$ref": "#/$defs/byeReason" }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/reply" }
  ]
}
