#!/usr/bin/env bash
# Refuse force-pushes to main or dev. Refuse non-ff updates of main.
set -euo pipefail

remote_name="${1:-}"
url="${2:-}"

zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    main|dev) ;;
    *) continue ;;
  esac

  if [[ "$local_sha" == "$zero" ]]; then
    echo "Refusing to delete origin/${branch}." >&2
    exit 1
  fi

  if [[ "$remote_sha" != "$zero" ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "Refusing non-fast-forward update of origin/${branch}." >&2
    exit 1
  fi

  if [[ "$branch" == "main" && "$remote_sha" != "$zero" ]]; then
    # New tip of main must be a merge commit, or an ancestor already on origin/main
    # (no-op / already pushed). Hotfix merges count as merges.
    parent2="$(git rev-parse --verify --quiet "${local_sha}^2" || true)"
    if [[ -z "$parent2" && "$local_sha" != "$remote_sha" ]]; then
      echo "Refusing to push non-merge commits to origin/main. Promote via a merge from dev or hotfix/*." >&2
      exit 1
    fi
  fi
done

unset remote_name url
